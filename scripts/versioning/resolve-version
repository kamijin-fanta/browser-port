#!/usr/bin/env bash
set -euo pipefail

DEFAULT_TAG="${DEFAULT_TAG:-v0.1.0}"
RELEASE_TAG_REGEX='^v[0-9]+\.[0-9]+\.[0-9]+$'

SHORT_SHA="$(git rev-parse --short=7 HEAD)"

exact_tag="$(
  git tag --points-at HEAD \
    | grep -E "$RELEASE_TAG_REGEX" \
    | head -n1 \
    || true
)"

if [[ -n "$exact_tag" ]]; then
  release_version="${exact_tag#v}"
  full_version="$release_version"
  is_tag_release="true"
  tag_name="$exact_tag"
  commits_since_tag="0"
else
  nearest_tag="$(
    git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null \
      || true
  )"

  if [[ -n "$nearest_tag" ]]; then
    tag_name="$nearest_tag"
    release_version="${nearest_tag#v}"
    commits_since_tag="$(git rev-list --count "${nearest_tag}..HEAD")"
  else
    tag_name="$DEFAULT_TAG"
    release_version="${DEFAULT_TAG#v}"
    commits_since_tag="$(git rev-list --count HEAD)"
  fi

  full_version="${release_version}-dev.${commits_since_tag}+g${SHORT_SHA}"
  is_tag_release="false"
fi

if [[ ! "$tag_name" =~ $RELEASE_TAG_REGEX ]]; then
  echo "Invalid tag value resolved: $tag_name" >&2
  exit 1
fi

if [[ ! "$release_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Invalid release version resolved: $release_version" >&2
  exit 1
fi

cat <<EOF
RELEASE_VERSION=$release_version
FULL_VERSION=$full_version
IS_TAG_RELEASE=$is_tag_release
TAG_NAME=$tag_name
COMMITS_SINCE_TAG=$commits_since_tag
SHORT_SHA=$SHORT_SHA
EOF
